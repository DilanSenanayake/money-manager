# Copy values into apps/api/src/Ledgerly.Api/appsettings.Development.json
# (that file is gitignored). Template: appsettings.Development.json.example
#
# Or set as environment variables (recommended for production).

# Supabase — Url + AnonKey from apps/web/.env.local
SUPABASE__URL=https://your-project.supabase.co
SUPABASE__ANONKEY=your-anon-key
# Optional HS256 secret when Auth is still HMAC (JWKS empty).
# Works together with SUPABASE__URL. Do NOT put a signing-key id (UUID) here —
# asymmetric projects validate via JWKS at {URL}/auth/v1/.well-known/jwks.json
# SUPABASE__JWTSECRET=your-legacy-jwt-secret

# Groq free tier — https://console.groq.com/keys
GROQ__APIKEY=your-groq-api-key
# Optional overrides:
# GROQ__BASEURL=https://api.groq.com/openai/v1
# GROQ__MODELS__0=openai/gpt-oss-20b
# GROQ__MODELS__1=openai/gpt-oss-120b

# CORS
# CORS__ORIGINS__0=http://localhost:3000
