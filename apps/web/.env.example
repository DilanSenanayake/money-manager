# Supabase (web auth — JWT is forwarded to the API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin used for canonical URLs, sitemap, and Open Graph.
# Production (also the code fallback when VERCEL_ENV=production):
# NEXT_PUBLIC_SITE_URL=https://www.smoneymanager.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Smart Money Manager API
# Prefer API_URL (server-only, not inlined into the browser bundle).
# NEXT_PUBLIC_API_URL remains supported for existing Vercel projects.
#
# Development:
API_URL=http://localhost:5080
NEXT_PUBLIC_API_URL=http://localhost:5080
#
# Production (HTTPS required for a public deployment):
# API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Analytics (optional)
# Vercel Web Analytics: enable it on the Vercel project; the app already injects <Analytics />.
# Google Analytics 4 web stream. The app also falls back to this ID in code.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YH8936B98F

# Public inbox shown on Terms and Privacy pages.
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=diladws@gmail.com
