# Supabase (web auth — JWT is forwarded to the API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Smart Money Manager API — must be reachable from Vercel in production (HTTPS preferred)
# Development:
# NEXT_PUBLIC_API_URL=http://localhost:5080
# Production / staging (examples):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=http://<vm-host>:8080

NEXT_PUBLIC_API_URL=http://localhost:5080
